default(parisize,"1g");
F = ffinit(59, 2);
W = ffgen(F, 'W);
o1 = W^0; z0 = W*0;
I = 0*W; for(k=0,58, for(l=0,58, z = k + l*W; if(z^2 == -1 + z0, I = z))); 
print("I^2+1==0: ", I^2 + o1 == z0);
E = ellinit([0,0,0,1+0*W,0*W]);
T1 = [0*W, 0*W];
T2 = [I, 0*W];
print("T2 on E: ", ellisoncurve(E, T2));
print("e2(T1,T2)==-1: ", ellweilpairing(E, T1, T2, 2) == -1 + z0);
R = ellgenerators(E);
P4 = ellmul(E, R[1], 15);
Q4 = ellmul(E, R[2], 15);
print("P4 o4: ", ellmul(E,P4,4)==ellmul(E,R[1],0), " ", ellmul(E,P4,2)!=ellmul(E,R[1],0));
print("Q4 o4: ", ellmul(E,Q4,4)==ellmul(E,R[1],0), " ", ellmul(E,Q4,2)!=ellmul(E,R[1],0));
print("dep: ", ellmul(E,P4,2) == ellmul(E,Q4,2));
e4 = ellweilpairing(E, P4, Q4, 4);
print("e4: ", e4, " e4^4==1: ", e4^4 == o1, " e4==1: ", e4 == o1);
