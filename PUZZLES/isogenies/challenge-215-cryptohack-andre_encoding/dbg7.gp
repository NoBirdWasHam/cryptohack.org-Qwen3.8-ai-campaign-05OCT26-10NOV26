default(parisize, "6g");
read("params.gp");
read("dompts.gp");
F = ffinit(PVAL, 2);
W = ffgen(F, 'W);
o1 = W^0; z0 = W*0;
ffsqrt_ts(r) = { local(q, e, mm, z, c, x, t, i, b); if(r == 0, return(z0)); q = PVAL^2; if(r^((q-1)>>1) != o1, return(-1)); e = valuation(q-1, 2); mm = (q-1) >> e; z = W; while(z^((q-1)>>1) == o1, z = z+1); c = z^mm; x = r^((mm+1)>>1); t = r^mm; while(t != o1, i = 0; b = t; while(b != o1, b = b^2; i = i+1); b = c^(2^(e-i-1)); c = b^2; x = x*b; t = t*c); return(x); }
mk(re, im) = { re + im*I2 };
DATA = read("bytes.gp");
MVAL = PVAL + 1;
I2 = ffsqrt_ts(-1 + z0);
d0 = DATA[1];
Ax = mk(d0[1], d0[2]); Ay = mk(d0[3], d0[4]); Bx = mk(d0[5], d0[6]); By = mk(d0[7], d0[8]);
RA = Ay^2 - Ax^3; RB = By^2 - Bx^3;
a4 = (RA - RB)/(Ax - Bx); a6 = RA - a4*Ax;
Ep = ellinit([0,0,0,a4,a6]);
A = [Ax, Ay]; B = [Bx, By];
print("disc nonzero: ", 4*a4^3 + 27*a6^2 != 0);
Ed = ellinit([0,0,0,z0,o1]);
Pd = [mk(Px_re, Px_im), mk(Py_re, Py_im)];
Qd = [mk(Qx_re, Qx_im), mk(Qy_re, Qy_im)];
print("Pd on Ed: ", ellisoncurve(Ed, Pd));
l = 5; e = 3;
A25 = ellmul(Ep, A, MVAL/l^e); B25 = ellmul(Ep, B, MVAL/l^e);
P25 = ellmul(Ed, Pd, MVAL/l^e); Q25 = ellmul(Ed, Qd, MVAL/l^e);
LHS = ellweilpairing(Ep, A25, B25, l^e);
RHS = ellweilpairing(Ed, P25, Q25, l^e)^(2^64*99);
print("adjunction holds (b=99): ", LHS == RHS);
RHS2 = ellweilpairing(Ed, P25, Q25, l^e)^(2^64*1);
print("adjunction holds (b=1): ", LHS == RHS2);
X = ellmul(Ep, A, 37*LVAL/99); Y = ellmul(Ep, B, 37*LVAL/99);
Xm = ellmul(Ep, X, MVAL); Ym = ellmul(Ep, Y, MVAL);
print("e_m(X,Y)==1 (relation holds): ", ellweilpairing(Ep, Xm, Ym, MVAL) == o1);
