default(parisizemax, 1<<31);
p = 115792089210356248762697446949407573530086143415290314195533631308867097853951;
a = 115792089210356248762697446949407573530086143415290314195533631308867097853948;
bs = [16157387885063800092468972531095442600227637936690303362357377535130907802014,68374361576449959379811878238702970795767227995234058958640265755013581201578];
for(i=1, #bs,
  E = ellinit([0,0,0,Mod(a,p),Mod(bs[i],p)]);
  n = ellcard(E);
  c = factor(n, 10^6);
  s = Str("@", bs[i], " ", n);
  for(j=1, matsize(c)[1], s = Str(s, " ", c[j,1], ":", c[j,2]));
  print(s);
);
