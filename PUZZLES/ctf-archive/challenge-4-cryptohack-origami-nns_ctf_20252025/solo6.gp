default(parisize,"2G");
read("pk.gp");
n=512;q=127;d=1024;
M=matrix(d,d);
for(i=1,n,for(j=1,n,M[i,j]=if(i==j,1,0); M[i,n+j]=pkv[((j-i)%n)+1]; M[n+i,n+j]=if(i==j,q,0)));
V=M~;
T=qflll(V,0); V=V*T;
print("init ",gettime());
best=10^9;
for(r=1,300,for(k=1,100,i=random(d)+1; j=random(d)+1; c=random(3)-1; if(i!=j,for(t=1,d,V[t,i]+=c*V[t,j]))); T=qflll(V,0); V=V*T; mn=10^9; for(i=1,d,s=sum(j=1,d,V[j,i]^2); if(s<mn,mn=s)); if(mn<best,best=mn; print("round ",r," best norm2 ",best," t=",gettime())); if(best<=200,for(k=1,d,if(sum(j=1,d,V[j,k]^2)<=200,print1("DUMP "); for(j=1,n,print1(V[j,k]," ")); print1("| "); for(j=1,n,print1(V[n+j,k]," ")); print(" END")))););
print("chain done best=",best);
