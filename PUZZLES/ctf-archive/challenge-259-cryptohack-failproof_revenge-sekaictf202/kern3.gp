default(parisize,"4G");
D_ = "~/Practice_runs/cryptohack_org/challenge-259-cryptohack-failproof_revenge-sekaictf202/";
read(D_ "A.gp");
read(D_ "cvecs.gp");
print("read done ", matsize(A));
R = matsnf(A, 1);
U_ = R[1]; V_ = R[2]; Dm = R[3];
print("matsnf done ", matsize(U_), matsize(V_), matsize(Dm));
n = matsize(A)[2]; m = matsize(A)[1];
cnz = vector(n, i, sum(k=1,m, Dm[k,i]^2));
kcols = select(i->cnz[i]==0, [1..n]);
nzcols = select(i->cnz[i]!=0, [1..n]);
print("kernel dim: ", #kcols, " rank cols: ", #nzcols);
dvec = vector(m, j, Dm[j, nzcols[j]]);
print("divisors max: ", vecmax(dvec));
Kraw2 = matrix(#kcols, n, i, k, V_[k, kcols[i]]);
print("Kraw2 size ", matsize(Kraw2));
Uk = qflll(Kraw2~);
Kred = (Kraw2~ * Uk)~;
print("qflll done");
apply(r->write(D_ "Kred.txt", concat(Str(Vec(Kred[r,])), "\n")), [1..matsize(Kred)[1]]);
M7 = matrix(m, NB, i, b, eval(Str("c",b))[i]);
UCx = U_*M7;
pos = vector(n, i, 0);
for(j=1, m, pos[nzcols[j]] = j);
Y = matrix(n, NB, i, b, if(pos[i]==0, 0, UCx[pos[i], b] \ dvec[pos[i]]));
M0s = V_*Y;
print("m0 done");
apply(b->write(D_ "m0.txt", concat(Str(Vec(M0s[,b])), "\n")), [1..NB]);
print("ALLDONE");
