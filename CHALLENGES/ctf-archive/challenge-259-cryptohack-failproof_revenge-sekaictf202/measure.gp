default(parisize,"1500M");
D_ = "~/Practice_runs/cryptohack_org/challenge-259-cryptohack-failproof_revenge-sekaictf202/";
read(D_ "rev_keep.txt");
read(D_ "rev_K.gp");
read(D_ "revb1.gp");
nb = #KEEPV;
d = matsize(K)[1];
Kf = Mat(K*1.0);
B2 = 2.0*Kf;
G0 = B2*B2~;
U0 = qflllgram(G0, 1);
Bred = U0*B2;
nearestplaneF(B,t) = { local(mm,nn,bs,cs,tt,i,k,v,mu,q); mm=matsize(B)[1]; nn=matsize(B)[2]; bs=vector(mm); cs=vector(mm); for(i=1,mm, v=Vec(B[i,]); for(k=1,i-1, if(cs[k]<=0, next()); mu=vecsum(vector(nn, j, B[i,j]*bs[k][j]))/cs[k]; if(mu!=0, v=v-mu*bs[k])); bs[i]=v; cs[i]=vecsum(vector(nn, j, v[j]*v[j]))); tt=Vec(t); forstep(i=mm,1,-1, if(cs[i]<=0, next()); q=round(vecsum(vector(nn, j, tt[j]*bs[i][j]))/cs[i]); if(q!=0, tt=tt-q*Vec(B[i,]))); tt };
T0 = vector(nb, i, (1.0 - 2*m0p[i]));
Tred = nearestplaneF(Bred, T0);
print("@@Tredf norm2 = ", vecsum(vector(nb, i, Tred[i]^2)));
rows = vector(d+1);
for(r=1, d, rows[r] = concat(Vec(Bred[r,]), [0.0]));
rows[d+1] = concat(Tred, [1.0]);
M = matrix(d+1, nb+1, r, c, rows[r][c]);
Gm = M*M~;
Um = qflllgram(Gm, 1);
Ml = Um*M;
G = Ml*Ml~;
gsnorms() = { local(n,bstar,dv,i,j,s); n=matsize(G)[1]; bstar=vector(n); for(i=1,n, bstar[i]=Vec(Vec(G[i,]))); for(i=1,n, for(j=1,i-1, s=vecsum(vector(n,k,bstar[i][k]*bstar[j][k]))/norm2v; dv=vecsum(vector(n,k,bstar[j][k]^2)); bstar[i]=bstar[i]-(s/dv)*bstar[j])); for(i=1,n, print("@@GS@@", i, "@@", round(vecsum(vector(n,k,bstar[i][k]^2))*1e6)/1e6)); };
norm2v = vecsum(vector(d+1, k, Vec(G[1,])[k]^2));
norm2v = 0;
gs2() = { local(n,bstar,i,j,dv); n=matsize(G)[1]; bstar=vector(n); for(i=1,n, bstar[i]=Vec(Vec(G[i,]))); for(i=1,n, for(j=1,i-1, dv=vecsum(vector(n,k,bstar[j][k]^2)); if(dv<=1e-30, next()); mu=vecsum(vector(n,k,bstar[i][k]*bstar[j][k]))/dv; bstar[i]=bstar[i]-mu*bstar[j])); vv=vector(n, i, vecsum(vector(n,k,bstar[i][k]^2))); print("@@count le 513: ", #select(x->x<=513, vv)); print("@@count le 2000: ", #select(x->x<=2000, vv)); print("@@count le 50000: ", #select(x->x<=50000, vv)); print("@@first20: ", apply(x->round(x), Vec(vv)[1..20])); print("@@last20: ", apply(x->round(x), Vec(vv)[(n-19)..n])); print("@@minmax: ", vecmin(vv), " ", vecmax(vv)); };
gs2();
GK = Bred*Bred~;
gsk() = { local(n,bstar,i,j,dv,vv); G2=GK; n=matsize(G2)[1]; bstar=vector(n); for(i=1,n, bstar[i]=Vec(Vec(G2[i,]))); for(i=1,n, for(j=1,i-1, dv=vecsum(vector(n,k,bstar[j][k]^2)); if(dv<=1e-30, next()); mu=vecsum(vector(n,k,bstar[i][k]*bstar[j][k]))/dv; bstar[i]=bstar[i]-mu*bstar[j])); vv=vector(n, i, vecsum(vector(n,k,bstar[i][k]^2))); print("@@Kcount le 513: ", #select(x->x<=513, vv)); print("@@Kmin gs: ", vecmin(vv)); print("@@Klast20: ", apply(x->round(x), Vec(vv)[(n-19)..n])); };
gsk();
print("@@MEASUREDONE@@")
