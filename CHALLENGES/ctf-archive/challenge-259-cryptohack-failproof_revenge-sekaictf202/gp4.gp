default(parisize,"4G");
D_ = "~/Practice_runs/cryptohack_org/challenge-259-cryptohack-failproof_revenge-sekaictf202/";
read(D_ "A.gp");
read(D_ "cvecs.gp");
read(D_ "c1adj.gp");
m = 256;
drop_mid = [193,201,209,217,225,233,241,249];
drop_b0 = [k | k <- [193..248]];
drop_b6 = [441,442,443,444,445,446,447,448];
print("prep done");
\\ Variant MID for blocks 2..6
dm = vector(512,i,0); for(j=1,#drop_mid, dm[drop_mid[j]]=1);
kl = Vecsmall(select(k->dm[k]==0, [1..512]));
A2 = matrix(256, #kl, i, j, A[i, kl[j]]);
print("mid A2 ", matsize(A2));
write(D_ "keep_mid.txt", concat(Str(kl), "\n"));
R = matsnf(A2, 1);
U_ = R[1]; V_ = R[2]; Dm = R[3];
n2 = matsize(A2)[2];
cnz = vector(n2, i, sum(k=1,256, Dm[k,i]^2));
kcols = select(i->cnz[i]==0, [1..n2]);
nzcols = select(i->cnz[i]!=0, [1..n2]);
print("mid kerdim ", #kcols);
Kraw2 = matrix(#kcols, n2, i, k, V_[k, kcols[i]]);
Uk = qflll(Kraw2~);
Kred = (Kraw2~ * Uk)~;
apply(r->write(D_ "K_mid.txt", concat(Str(Vec(Kred[r,])), "\n")), [1..matsize(Kred)[1]]);
genmid(b) = eval(Str("c",b));
Ucm = U_*Mat(Vec(genmid(2))~);
Uc = apply(i->Ucm[i,1], [1..256]);
y = vector(n2, i, 0);
for(j=1,256, y[nzcols[j]] = Uc[j]);
m0v = V_*Mat(y)~;
write(D_ "m0_mid2.txt", concat(Str(apply(i->m0v[i,1],[1..n2])), "\n"));
Ucm = U_*Mat(Vec(genmid(3))~);
Uc = apply(i->Ucm[i,1], [1..256]);
y = vector(n2, i, 0);
for(j=1,256, y[nzcols[j]] = Uc[j]);
m0v = V_*Mat(y)~;
write(D_ "m0_mid3.txt", concat(Str(apply(i->m0v[i,1],[1..n2])), "\n"));
Ucm = U_*Mat(Vec(genmid(4))~);
Uc = apply(i->Ucm[i,1], [1..256]);
y = vector(n2, i, 0);
for(j=1,256, y[nzcols[j]] = Uc[j]);
m0v = V_*Mat(y)~;
write(D_ "m0_mid4.txt", concat(Str(apply(i->m0v[i,1],[1..n2])), "\n"));
Ucm = U_*Mat(Vec(genmid(5))~);
Uc = apply(i->Ucm[i,1], [1..256]);
y = vector(n2, i, 0);
for(j=1,256, y[nzcols[j]] = Uc[j]);
m0v = V_*Mat(y)~;
write(D_ "m0_mid5.txt", concat(Str(apply(i->m0v[i,1],[1..n2])), "\n"));
Ucm = U_*Mat(Vec(genmid(6))~);
Uc = apply(i->Ucm[i,1], [1..256]);
y = vector(n2, i, 0);
for(j=1,256, y[nzcols[j]] = Uc[j]);
m0v = V_*Mat(y)~;
write(D_ "m0_mid6.txt", concat(Str(apply(i->m0v[i,1],[1..n2])), "\n"));
print("MIDDONE");
\\ Variant B0
dm = vector(512,i,0); for(j=1,#drop_b0, dm[drop_b0[j]]=1);
kl = Vecsmall(select(k->dm[k]==0, [1..512]));
A2 = matrix(256, #kl, i, j, A[i, kl[j]]);
print("b0 A2 ", matsize(A2));
write(D_ "keep_b0.txt", concat(Str(kl), "\n"));
R = matsnf(A2, 1);
U_ = R[1]; V_ = R[2]; Dm = R[3];
n2 = matsize(A2)[2];
cnz = vector(n2, i, sum(k=1,256, Dm[k,i]^2));
kcols = select(i->cnz[i]==0, [1..n2]);
nzcols = select(i->cnz[i]!=0, [1..n2]);
print("b0 kerdim ", #kcols);
Kraw2 = matrix(#kcols, n2, i, k, V_[k, kcols[i]]);
Uk = qflll(Kraw2~);
Kred = (Kraw2~ * Uk)~;
apply(r->write(D_ "K_b0.txt", concat(Str(Vec(Kred[r,])), "\n")), [1..matsize(Kred)[1]]);
Ucm = U_*Mat(Vec(c1adj)~);
Uc = apply(i->Ucm[i,1], [1..256]);
y = vector(n2, i, 0);
for(j=1,256, y[nzcols[j]] = Uc[j]);
m0v = V_*Mat(y)~;
write(D_ "m0_b0.txt", concat(Str(apply(i->m0v[i,1],[1..n2])), "\n"));
print("wrote ", "m0_b0.txt");
print("B0DONE");
\\ Variant B6
dm = vector(512,i,0); for(j=1,#drop_b6, dm[drop_b6[j]]=1);
kl = Vecsmall(select(k->dm[k]==0, [1..512]));
A2 = matrix(256, #kl, i, j, A[i, kl[j]]);
print("b6 A2 ", matsize(A2));
write(D_ "keep_b6.txt", concat(Str(kl), "\n"));
R = matsnf(A2, 1);
U_ = R[1]; V_ = R[2]; Dm = R[3];
n2 = matsize(A2)[2];
cnz = vector(n2, i, sum(k=1,256, Dm[k,i]^2));
kcols = select(i->cnz[i]==0, [1..n2]);
nzcols = select(i->cnz[i]!=0, [1..n2]);
print("b6 kerdim ", #kcols);
Kraw2 = matrix(#kcols, n2, i, k, V_[k, kcols[i]]);
Uk = qflll(Kraw2~);
Kred = (Kraw2~ * Uk)~;
apply(r->write(D_ "K_b6.txt", concat(Str(Vec(Kred[r,])), "\n")), [1..matsize(Kred)[1]]);
cb = c7;
Ucm = U_*Mat(Vec(cb)~);
Uc = apply(i->Ucm[i,1], [1..256]);
y = vector(n2, i, 0);
for(j=1,256, y[nzcols[j]] = Uc[j]);
m0v = V_*Mat(y)~;
write(D_ "m0_b6.txt", concat(Str(apply(i->m0v[i,1],[1..n2])), "\n"));
print("wrote ", "m0_b6.txt");
print("B6DONE");
print("ALLDONE");
