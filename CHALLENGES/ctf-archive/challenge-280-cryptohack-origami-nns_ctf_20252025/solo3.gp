default(parisize,"1500M");
read("pk.gp");
n=512;q=127;d=1024;
M=matrix(d,d);
for(i=1,n,for(j=1,n,M[i,j]=if(i==j,1,0); M[i,n+j]=pkv[((j-i)%n)+1]; M[n+i,n+j]=if(i==j,q,0)));
B=qflll(M~,3);
print("init ",gettime());
best=10^9; mv=0;
for(r=1,2000,for(k=1,100,i=random(d)+1; j=random(d)+1; c=random(3)-1; if(i!=j,for(t=1,d,B[t,i]+=c*B[t,j]))); B=qflll(B,2); mn=10^9; mi=0; for(i=1,d,s=sum(j=1,d,B[j,i]^2); if(s<mn,mn=s; mi=i)); if(mn<best,best=mn; print("round ",r," best norm2 ",best," t=",gettime())); if(best<=200,mv=mi; print1("DUMP "); for(j=1,n,print1(B[j,mv]," ")); print1("| "); for(j=1,n,print1(B[n+j,mv]," ")); print(" END")););
print("chain done best=",best);
