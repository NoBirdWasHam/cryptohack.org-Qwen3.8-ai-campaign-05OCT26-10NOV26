default(parisizemax,0); default(parisize,2^30);
pp = 2^192 - 237;
E = ellinit([0,0,0,-3,1379137549983732744405137513333094987949371790433997718123], pp);
P = [3, 2328097520547690433014505636654192255862895915713013556507];
print("P on E: ", ellisoncurve(E, P));
N = 6277101735386680763835789423072729104060819681027498877478;
Q = ellmul(E, P, N);
print("N*P = ", Q);
R = ellmul(E, P, 123456789012345);
print("k0*P x = ", R[1]);
