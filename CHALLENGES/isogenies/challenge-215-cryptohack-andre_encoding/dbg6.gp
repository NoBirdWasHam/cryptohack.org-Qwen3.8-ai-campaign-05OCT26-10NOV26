default(parisize, "6g");
read("params.gp");
F = ffinit(PVAL, 2);
W = ffgen(F, 'W);
o1 = W^0; z0 = W*0;
ffsqrt_ts(r) = { local(q, e, mm, z, c, x, t, i, b); if(r == 0, return(z0)); q = PVAL^2; if(r^((q-1)>>1) != o1, return(-1)); e = valuation(q-1, 2); mm = (q-1) >> e; z = W; while(z^((q-1)>>1) == o1, z = z+1); c = z^mm; x = r^((mm+1)>>1); t = r^mm; while(t != o1, i = 0; b = t; while(b != o1, b = b^2; i = i+1); b = c^(2^(e-i-1)); c = b^2; x = x*b; t = t*c); return(x); }
mk(re, im) = { re + im*I2 };
DATA = read("bytes.gp");
MVAL = PVAL + 1;
I2 = ffsqrt_ts(-1 + z0);
d = DATA[1];
Ax = mk(d[1], d[2]); Ay = mk(d[3], d[4]); Bx = mk(d[5], d[6]); By = mk(d[7], d[8]);
RA = Ay^2 - Ax^3; RB = By^2 - Bx^3;
a4 = (RA - RB)/(Ax - Bx); a6 = RA - a4*Ax;
E = ellinit([0,0,0,a4,a6]);
A = [Ax, Ay];
Tl = ellmul(E, A, MVAL/2^64);
print("Tl repr: ", Vecsmall([0])); 
print("type Tl: ", type(Tl));
print("Tl == [0,1,0]: ", Tl == [0,1,0]);
T2 = ellmul(E, Tl, 2);
print("T2 ok: ", T2 != Tl);
cur = Tl; va = 0;
while(cur != [0,1,0] && va < 70, cur = ellmul(E, cur, 2); va = va+1; if(va % 10 == 0, print("va=", va)));
print("loop done va=", va, " reached O: ", cur == [0,1,0]);
Z = ellmul(E, A, MVAL);
print("O repr: ", Z, " type: ", type(Z));
print("O == [0,1,0]: ", Z == [0,1,0]);
Z2 = ellmul(E, Tl, 2^64);
print("2^64*Tl == O: ", Z2 == Z);
