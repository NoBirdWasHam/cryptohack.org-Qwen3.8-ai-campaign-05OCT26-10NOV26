default(parisize, "6g");
read("params.gp");
F = ffinit(PVAL, 2);
W = ffgen(F, 'W);
o1 = W^0; z0 = W*0;
ffsqrt_ts(r) = { local(q, e, mm, z, c, x, t, i, b); if(r == 0, return(z0)); q = PVAL^2; if(r^((q-1)>>1) != o1, return(-1)); e = valuation(q-1, 2); mm = (q-1) >> e; z = W; while(z^((q-1)>>1) == o1, z = z+1); c = z^mm; x = r^((mm+1)>>1); t = r^mm; while(t != o1, i = 0; b = t; while(b != o1, b = b^2; i = i+1); b = c^(2^(e-i-1)); c = b^2; x = x*b; t = t*c); return(x); }
mk(re, im) = { re + im*I2 };
DATA = read("bytes.gp");
MVAL = PVAL + 1;
I2 = ffsqrt_ts(-1 + z0);
d = DATA[1];
Ax = mk(d[1], d[2]); Ay = mk(d[3], d[4]); Bx = mk(d[5], d[6]); By = mk(d[7], d[8]);
RA = Ay^2 - Ax^3; RB = By^2 - Bx^3;
a4 = (RA - RB)/(Ax - Bx); a6 = RA - a4*Ax;
E = ellinit([0,0,0,a4,a6]);
A = [Ax, Ay]; B = [Bx, By];
print("oncurve: ", ellisoncurve(E, A), " ", ellisoncurve(E, B));
l = 5; e = 2;
sc = 37*LVAL*MVAL/l^(e+1);
Xl = ellmul(E, A, sc); Yl = ellmul(E, B, sc);
print("Xl is O: ", Xl == [0,0], " Yl is O: ", Yl == [0,0]);
print("ord Xl: ", ellorder(E, Xl), " ord Yl: ", ellorder(E, Yl));
ev = ellweilpairing(E, Xl, Yl, l^e);
print("pairing == 1: ", ev == o1, " type: ", type(ev));
ev2 = ellweilpairing(E, Xl, Xl, l^e);
print("self pairing == 1: ", ev2 == o1);
t0 = time; Xl2 = ellmul(E, A, 37*LVAL*MVAL/2^65); print("ellmul 2^65 scalar ms-ish: ", time - t0);
t0 = time; ev3 = ellweilpairing(E, Xl, Yl, 5^2); print("pairing 25 ms-ish: ", time - t0);
t0 = time; ev4 = ellweilpairing(E, Xl, Yl, 3^5); print("pairing 243: ", time - t0);
