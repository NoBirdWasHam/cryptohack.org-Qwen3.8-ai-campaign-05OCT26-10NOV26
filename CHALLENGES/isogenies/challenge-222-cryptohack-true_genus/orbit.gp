\\ Isogeny orbit BFS over Fp for curves y^2 = x^3 + a4 x + a6 (trace-0 CSIDH set)
\\ + step by l: quotient by E(Fp)[l]  (the +1 Frobenius eigenspace)
\\ - step by l: twist, + step, untwist  (the -1 eigenspace)

jinv(p,a4,a6) = {
  my(D = -16*(4*a4^3 + 27*a6^2) % p);
  (-48*a4)^3 * Mod(D,p)^-1;
}

twist(p,a4,a6,d) = [a4 * Mod(d,p)^-2, a6 * Mod(d,p)^-3];
untwist(p,a4,a6,d) = [a4 * Mod(d,p)^2, a6 * Mod(d,p)^3];

findpoint(p,a4,a6,x0) = {
  my(x=x0, v);
  while(1,
    v = Mod(x^3 + a4*x + a6, p);
    if(v != 0 && issquare(v), return([Mod(x,p), sqrt(v)]));
    x = x+1;
  );
}

\\ kernel polynomial of cyclic order-l subgroup generated by Q
kernpoly(E,Q,l,xv) = {
  my(h = Pol(1,xv), R);
  for(i=1,(l-1)/2,
    R = ellmul(E,Q,i);
    h = h * (xv - R[1]);
  );
  h;
}

\\ + step: quotient by E(Fp)[l]; returns [a4p,a6p]
stepplus(p,a4,a6,l,xv) = {
  my(E = ellinit([0,0,0,a4,a6]), x0=1, Q, E2, tries=0);
  while(1,
    my(P = findpoint(p,a4,a6,x0));
    Q = ellmul(E, P, (p+1)\l);
    if(#Q>1 && ellmul(E,Q,l)==[0], break);
    x0 = x0+1; tries++;
    if(tries>30, error("no order-l point"));
  );
  E2 = ellisogeny(E, kernpoly(E,Q,l,xv))[1];
  [E2[4], E2[5]];
}

stepminus(p,a4,a6,l,d,xv) = {
  my(t = twist(p,a4,a6,d), r = stepplus(p,t[1],t[2],l,xv));
  untwist(p,r[1],r[2],d);
}

\\ BFS orbit from [a4,a6]; returns map j -> [a4,a6,parentj,l,dir]
orbitBFS(p,a4,a6,ls,d,cap) = {
  my(xv='x, m=Map(), order=[jinv(p,a4,a6)], idx=1, jj, v, nb, l, r);
  mapput(m, jinv(p,a4,a6), [a4,a6,-1,0,0]);
  while(idx <= #order,
    jj = order[idx];
    mapisdefined(m, jj, &v);
    for(k=1,#ls,
      l = ls[k];
      for(si=1,2,
        s = if(si==1, 1, -1);
        if(s==1, r = stepplus(p,v[1],v[2],l,xv), r = stepminus(p,v[1],v[2],l,d,xv));
        nb = jinv(p,r[1],r[2]);
        if(!mapisdefined(m,nb),
          mapput(m, nb, [r[1],r[2],jj,l,s]);
          order = concat(order,[nb]);
        );
      );
    );
    if(idx % 50 == 0, print("BFS idx=",idx," size=",#order));
    if(#order > cap, print("CAP HIT at size ",#order); break);
    idx = idx+1;
  );
  print("ORBIT SIZE = ", #order);
  [m, order];
}

\\ reconstruct word for node j: list of [l,dir]
getword(m,jj) = {
  my(w=[], v, cur=jj);
  while(1,
    mapisdefined(m,cur,&v);
    if(v[3]==-1, break);
    w = concat([[v[4],v[5]]], w);
    cur = v[3];
  );
  w;
}

\\ walk curve by word
walkword(p,a4,a6,w,d) = {
  my(xv='x, r);
  for(i=1,#w,
    if(w[i][2]==1, r = stepplus(p,a4,a6,w[i][1],xv), r = stepminus(p,a4,a6,w[i][1],d,xv));
    a4=r[1]; a6=r[2];
  );
  [a4,a6];
}
