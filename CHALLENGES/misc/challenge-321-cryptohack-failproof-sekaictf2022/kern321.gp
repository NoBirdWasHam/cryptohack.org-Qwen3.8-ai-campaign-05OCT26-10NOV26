default(parisize,"2G");
D_ = "~/Practice_runs/cryptohack_org/challenge-321-cryptohack-failproof-sekaictf2022/";
read(D_ "A.gp");
read(D_ "cvecs.gp");
drop0 = concat([1..56], [8*j+1 | j <- [7..31]]);
dropmid = [8*j+1 | j <- [0..31]];
gen(varname, cb, drop) = {
  local(dm, kl, A2, R, U_, V_, Dm, n2, cnz, kcols, nzcols, Kraw2, Uk, Kred, cc, Ucm, Uc, y, m0v, fn);
  dm = vector(256, i, 0); for(j=1, #drop, dm[drop[j]]=1);
  kl = Vecsmall(select(k -> dm[k]==0, [1..256]));
  A2 = matrix(128, #kl, i, j, A[i, kl[j]]);
  fn = Str(D_, "keep_", varname, ".txt");
  write(fn, concat(Str(kl), "\n"));
  R = matsnf(A2, 1);
  U_ = R[1]; V_ = R[2]; Dm = R[3];
  n2 = matsize(A2)[2];
  cnz = vector(n2, i, sum(k=1, 128, Dm[k, i]^2));
  kcols = select(i -> cnz[i]==0, [1..n2]);
  nzcols = select(i -> cnz[i]!=0, [1..n2]);
  print(varname, " n2=", n2, " kerdim=", #kcols, " rank=", #nzcols);
  Kraw2 = matrix(#kcols, n2, i, k, V_[k, kcols[i]]);
  Uk = qflll(Kraw2~);
  Kred = (Kraw2~ * Uk)~;
  fn = Str(D_, "K_", varname, ".txt");
  write(fn, "");
  apply(r -> write(fn, concat(Str(Vec(Kred[r, ])), "\n")), [1..matsize(Kred)[1]]);
  cc = eval(Str("c", cb));
  Ucm = U_ * Mat(Vec(cc)~);
  Uc = apply(i -> Ucm[i, 1], [1..128]);
  y = vector(n2, i, 0);
  for(j=1, #nzcols, y[nzcols[j]] = Uc[j] / Dm[j, nzcols[j]]);
  m0v = V_ * Mat(y)~;
  fn = Str(D_, "m0_", varname, ".txt");
  write(fn, concat(Str(apply(i -> m0v[i, 1], [1..n2])), "\n"));
  print(varname, " check max|A*m0-c|: ", vecmax(vector(128, j, abs(sum(k=1, n2, A2[j, k] * m0v[k, 1]) - cc[j]))));
};
gen("b0", 1, drop0);
gen("mid2", 2, dropmid);
print("ALLDONE");
